{
  "name": "sledge",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "tsr generate && vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/led-contract.test.ts",
