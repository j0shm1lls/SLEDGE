# NexBar Valve-compatible shim and Nollie1 permissions.
KERNEL=="valve-leds-shim", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="leds", KERNEL=="valve-leds*", MODE="0666", TAG+="uaccess"

# Nollie controllers: known VID candidates plus name matches.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="16d0", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3061", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{manufacturer}=="*Nollie*", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{product}=="*Nollie*", MODE="0666", TAG+="uaccess"
