+def _is_nollie_cdc_blob(blob: str) -> bool:
+    low = str(blob).lower()
+    return bool(
+        re.search(r'hid_id=[^:\n]*:0*16d5:0*2a01(?:\n|$)', low)
+        or re.search(r'product=0*16d5/0*2a01/', low)
+        or (re.search(r'id_vendor_id=16d5(?:\n|$)', low)
+            and re.search(r'id_model_id=2a01(?:\n|$)', low))
+    )
